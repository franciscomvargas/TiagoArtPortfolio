---
import { site } from '../config';
---

<section class="social-band" aria-label="Redes sociais">
  <div class="social-grid">
    <a class="social-link" href={site.instagram} target="_blank" rel="noopener noreferrer">
      <span class="social-label">
        <small>Acompanha o processo · {site.handle}</small>
        <strong>Instagram</strong>
      </span>
      <span class="social-arrow" aria-hidden="true">↗</span>
    </a>
    <a class="social-link" href={site.tiktok} target="_blank" rel="noopener noreferrer">
      <span class="social-label">
        <small>Bastidores e novas peças · {site.handle}</small>
        <strong>TikTok</strong>
      </span>
      <span class="social-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</section>
