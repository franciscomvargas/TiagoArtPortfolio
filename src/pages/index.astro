---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Shelf from '../components/Shelf.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Social from '../components/Social.astro';
import Contact from '../components/Contact.astro';
import { pieces } from '../lib/pieces';

const heroPiece = pieces[0];
---

<Base>
  <Hero piece={heroPiece} />
  <section class="manifesto">
    <div class="container manifesto-inner">
      <span class="manifesto-mark" aria-hidden="true">“</span>
      <blockquote>
        <p>Dou <em>nova vida</em> a objetos esquecidos.</p>
        <cite>Tiago Costa · Oliveira de Azeméis</cite>
      </blockquote>
    </div>
  </section>
  <Shelf pieces={pieces} />
  <Services />
  <About />
  <Process />
  <Social />
  <Contact />
</Base>
